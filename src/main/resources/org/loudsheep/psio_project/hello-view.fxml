<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="431.0" prefWidth="464.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.loudsheep.psio_project.frontend.controllers.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane prefHeight="391.0" prefWidth="321.0">
      <children>
         <DatePicker fx:id="startDate" layoutX="80.0" layoutY="10.0" prefHeight="25.0" prefWidth="212.0" />
          <Button layoutX="16.0" layoutY="113.0" onAction="#onHelloButtonClick" text="Hello!" />

          <Label fx:id="welcomeText" layoutX="80.0" layoutY="117.0" text="Initial text" />
         <Label layoutX="14.0" layoutY="14.0" text="Start Date" />
         <Label layoutX="14.0" layoutY="49.0" text="End Date" />
         <DatePicker fx:id="endDate" layoutX="80.0" layoutY="45.0" prefHeight="25.0" prefWidth="212.0" />
         <Label layoutX="18.0" layoutY="84.0" text="Symbol" />
         <TextField fx:id="symbol" layoutX="80.0" layoutY="80.0" prefHeight="25.0" prefWidth="212.0" />
         <Button fx:id="getButton" layoutX="310.0" layoutY="11.0" mnemonicParsing="false" onAction="#onGetButtonClick" prefHeight="93.0" prefWidth="100.0" text="Get Data" />
         <LineChart fx:id="lineChart" createSymbols="false" horizontalZeroLineVisible="false" layoutY="156.0" prefHeight="235.0" prefWidth="424.0" title="Stock Chart">
           <xAxis>
             <CategoryAxis side="BOTTOM" />
           </xAxis>
           <yAxis>
             <NumberAxis side="LEFT" />
           </yAxis>
         </LineChart>
         <MenuButton layoutX="163.0" layoutY="113.0" mnemonicParsing="false" text="Select Strategy">
           <items>
             <MenuItem fx:id="simpleUpAndDown" mnemonicParsing="false" text="Simple Up&amp;Down" />
           </items>
         </MenuButton>
      </children>
   </Pane>
</VBox>
