<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.loudsheep.psio_project.frontend.controllers.StrategyExecutionController">
   <children>
      <VBox layoutX="12.0" layoutY="14.0" prefHeight="66.0" prefWidth="576.0" style="-fx-border-color: black; -fx-border-radius: 3;">
         <children>
            <Label fx:id="selectedStrategyLabel" text="Strategy: " />
            <Label fx:id="strategyDescriptionLabel" alignment="TOP_LEFT" prefHeight="136.0" prefWidth="563.0" text="Strategy description:" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
      <VBox layoutX="12.0" layoutY="87.0" prefHeight="56.0" prefWidth="576.0" style="-fx-border-color: black; -fx-border-radius: 3;">
         <children>
            <Label text="Stock symbol:" />
            <Label text="Date range:" />
            <Label text="Total data points:" />
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </children>
