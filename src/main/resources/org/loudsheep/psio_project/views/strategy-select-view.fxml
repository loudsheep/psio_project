<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="460.0" prefWidth="600.0" stylesheets="@../styles/strategy-select.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.loudsheep.psio_project.frontend.controllers.StrategySelectController">
    <children>
        <MenuButton fx:id="strategyMenuButton" layoutX="13.0" layoutY="14.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="168.0" text="Select strategy">
            <items>
                <MenuItem fx:id="simpleUDStrategyButton" mnemonicParsing="false" onAction="#handleSimpleStrategy" text="Simple Up&amp;Down" />
            </items>
        </MenuButton>

        <VBox fx:id="parametersVBox" layoutX="13.0" layoutY="71.0" prefHeight="316.0" prefWidth="168.0" style="-fx-border-color: black; -fx-border-radius: 3; -fx-border-width: 1;">
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding></VBox>
      <Label layoutX="14.0" layoutY="56.0" text="Strategy params:" />
      <Pane layoutX="190.0" layoutY="32.0" prefHeight="125.0" prefWidth="395.0" style="-fx-border-color: black; -fx-border-radius: 3;">
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
         <children>
            <Label layoutX="8.0" layoutY="6.0" text="Symbol" />
            <TextField fx:id="symbolField" layoutX="8.0" layoutY="23.0" />
            <Label layoutX="8.0" layoutY="55.0" text="Start date" />
            <DatePicker fx:id="startDateField" layoutX="8.0" layoutY="72.0" prefHeight="25.0" prefWidth="149.0" />
            <DatePicker fx:id="endDateField" layoutX="232.0" layoutY="72.0" prefHeight="25.0" prefWidth="149.0" />
            <Label layoutX="232.0" layoutY="55.0" text="End date" />
            <Button fx:id="submitStockButton" layoutX="232.0" layoutY="23.0" mnemonicParsing="false" onAction="#handleStockData" prefHeight="25.0" prefWidth="149.0" text="Get data" />
            <Label fx:id="errorLabel" layoutX="8.0" layoutY="103.0" prefHeight="17.0" prefWidth="372.0" text="Label" textFill="RED" wrapText="true" />
         </children>
      </Pane>
      <Label layoutX="190.0" layoutY="14.0" text="Stock Data" />
      <LineChart fx:id="lineChart" createSymbols="false" layoutX="190.0" layoutY="164.0" legendVisible="false" prefHeight="222.0" prefWidth="395.0" title="Stock Chart">
        <xAxis>
          <CategoryAxis side="BOTTOM" tickLabelsVisible="false" tickMarkVisible="false" />
        </xAxis>
        <yAxis>
          <NumberAxis forceZeroInRange="false" prefHeight="181.0" prefWidth="29.0" side="LEFT" />
        </yAxis>
      </LineChart>
      <Button fx:id="executeButton" layoutX="15.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleExecuteButtonClick" prefHeight="52.0" prefWidth="569.0" text="Execute simulation" />
    </children>
</AnchorPane>
